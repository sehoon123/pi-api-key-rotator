{
  "provider": "my-company-ai",
  "api": "openai-completions",
  "keys": [
    { "id": "key-1", "value": "REPLACE_WITH_API_KEY_1" },
    { "id": "key-2", "value": "REPLACE_WITH_API_KEY_2" },
    { "id": "key-3", "value": "REPLACE_WITH_API_KEY_3" }
