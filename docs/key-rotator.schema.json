{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sehoon123/pi-api-key-rotator/v0.4.0/docs/key-rotator.schema.json",
  "title": "pi-api-key-rotator configuration",
  "description": "Default config location: <agent dir>/key-rotator.json, where <agent dir> is PI_CODING_AGENT_DIR when set and ~/.pi/agent otherwise. An explicit loader option and PI_KEY_ROTATOR_CONFIG take precedence.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "configVersion": {
          "const": 1
        },
        "poolId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "api": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/target"
          }
        },
        "keys": {
          "type": "array",
          "minItems": 2,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/key"
          }
        },
        "requestsPerKey": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "maxAttemptsPerRequest": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "cooldownMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        },
        "transientCooldownMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "maxRetryAfterMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        },
        "retryStatuses": {
          "allOf": [
            {
              "$ref": "#/$defs/statuses"
            },
            {
              "minItems": 1
            }
          ]
        },
        "disableStatuses": {
          "$ref": "#/$defs/statuses"
        },
        "cooldownStatuses": {
          "$ref": "#/$defs/statuses"
        },
        "rateLimitScope": {
          "enum": [
            "key",
            "target",
            "pool"
          ]
        },
        "targetFailureThreshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "retryNetworkErrors": {
          "type": "boolean"
        },
        "stateFile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "If omitted, uses <agent dir>/key-rotator-<poolId>.state.json. A relative value is resolved from the config directory."
        },
        "lockTimeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        },
        "staleLockMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 600000
        },
        "maxStateFileBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 16777216
        }
      },
      "required": [
        "keys"
      ],
      "oneOf": [
        {
          "required": [
            "provider",
            "api"
          ],
          "not": {
            "required": [
              "targets"
            ]
          }
        },
        {
          "required": [
            "targets"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "provider"
                ]
              },
              {
                "required": [
                  "api"
                ]
              }
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "configVersion": {
          "const": 1
        },
        "pools": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/pool"
          }
        }
      },
      "required": [
        "pools"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "pool": {
      "type": "object",
      "properties": {
        "poolId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "api": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/target"
          }
        },
        "keys": {
          "type": "array",
          "minItems": 2,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/key"
          }
        },
        "requestsPerKey": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "maxAttemptsPerRequest": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "cooldownMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        },
        "transientCooldownMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "maxRetryAfterMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        },
        "retryStatuses": {
          "allOf": [
            {
              "$ref": "#/$defs/statuses"
            },
            {
              "minItems": 1
            }
          ]
        },
        "disableStatuses": {
          "$ref": "#/$defs/statuses"
        },
        "cooldownStatuses": {
          "$ref": "#/$defs/statuses"
        },
        "rateLimitScope": {
          "enum": [
            "key",
            "target",
            "pool"
          ]
        },
        "targetFailureThreshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "retryNetworkErrors": {
          "type": "boolean"
        },
        "stateFile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "If omitted, uses <agent dir>/key-rotator-<poolId>.state.json. A relative value is resolved from the config directory."
        },
        "lockTimeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        },
        "staleLockMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 600000
        },
        "maxStateFileBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 16777216
        }
      },
      "required": [
        "keys"
      ],
      "oneOf": [
        {
          "required": [
            "provider",
            "api"
          ],
          "not": {
            "required": [
              "targets"
            ]
          }
        },
        {
          "required": [
            "targets"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "provider"
                ]
              },
              {
                "required": [
                  "api"
                ]
              }
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "api": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "provider",
        "api"
      ],
      "additionalProperties": false
    },
    "key": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "env": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "commandTimeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 120000
        }
      },
      "required": [
        "id"
      ],
      "oneOf": [
        {
          "required": [
            "env"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "value"
                ]
              },
              {
                "required": [
                  "command"
                ]
              },
              {
                "required": [
                  "commandTimeoutMs"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "value"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "env"
                ]
              },
              {
                "required": [
                  "command"
                ]
              },
              {
                "required": [
                  "commandTimeoutMs"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "command"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "env"
                ]
              },
              {
                "required": [
                  "value"
                ]
              }
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "statuses": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "integer",
        "minimum": 100,
        "maximum": 599
      }
    }
  }
}
